# Bu dosya sablondur; gercek degerler .env.local icine yazilir (git'e girmez).

# GitHub API kotasi icin. Kapsamsiz (zero-scope) fine-grained PAT yeterli:
# tokensiz saatte 60 istek hakki var ve asilirsa "Diger depolar" bolumu
# sessizce bosalir. Vercel'de her ortam icin tanimlanmali.
GH_TOKEN=

# Sitenin mutlak adresi. Vercel'de production icin tanimlanir;
# bos birakilirsa VERCEL_URL / localhost'a duser.
NEXT_PUBLIC_SITE_URL=https://tolguner.me

# --------------------------------------------------------------- Supabase

# Proje adresi ve herkese acik anahtar. Publishable key tarayiciya gonderilir,
# gizli degildir; guvenlik RLS ile saglanir. Vercel'de her ortama tanimlanir.
NEXT_PUBLIC_SUPABASE_URL=https://ecspngpnvotpmvyotnsw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# YALNIZCA YEREL. RLS'i tamamen atlar; seed scriptinin veritabanina yazmasi
# icin gerekir. VERCEL'E ASLA KONMAZ — admin paneli, giris yapmis kullanici
# olarak RLS altinda yazar; is_admin() kapisinin tum amaci budur.
SUPABASE_SECRET_KEY=
